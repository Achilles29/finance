includes:
    - phpstan-baseline.neon

parameters:
    level: 0
    paths:
        - ../../application
    scanFiles:
        - ci3-stubs.php
    reportUnmatchedIgnoredErrors: true
    tmpDir: %env.A4_STATIC_RUNTIME_DIR%/tmp
    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 8
        processTimeout: 120.0
